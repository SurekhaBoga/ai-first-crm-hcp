# Copy this file to .env and adjust per environment.

APP_NAME="AI-First CRM HCP API"
ENVIRONMENT=development

# Postgres, matching the approved architecture. Use a psycopg (v3) URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hcp_crm
DB_ECHO=false

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# AI layer (LangGraph + Groq). gemma2-9b-it (named in the original
# assignment) has been permanently decommissioned by Groq —
# llama-3.1-8b-instant is the closest currently-supported equivalent.
# See https://console.groq.com/docs/models for the live catalog.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=30
AI_MAX_LLM_RETRIES=2
